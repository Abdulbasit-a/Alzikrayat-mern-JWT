# Alzikrayat MERN Edition - Backend environment configuration
# Copy this file to ".env" and adjust the values. Never commit ".env".

# MongoDB connection string (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/alzikrayat

# Port the Express API listens on (the client dev proxy expects 5000)
PORT=5000

# Origin allowed by CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:3000

# Secret used to sign JWTs (Track A). Use a long random value; never commit the real one.
# Generate one with:  node scripts/generateSecret.js   (or any 64+ random characters)
JWT_SECRET=change-me-run-node-scripts-generateSecret-js

# How long a token stays valid (e.g. 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN=1d
